{
  "name": "zlink-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "build:fe": "npm --prefix ../client run build",
    "start": "npm run build:fe && npm run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "user:create": "node --experimental-strip-types scripts/create-user.ts",
    "db:migrate": "wrangler d1 migrations apply zlink --local",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
